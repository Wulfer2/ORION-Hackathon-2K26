      <visual name='rotor_0_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>2.5 2.5 2.5</scale>
            <uri>model://standard_vtol/meshes/iris_prop_ccw.dae</uri>
          </mesh>
        </geometry>
        <material><ambient>0 0 1 1.0</ambient><diffuse>0 0 1 1.0</diffuse></material>
      </visual>
      <gravity>1</gravity>
      <velocity_decay />
      <self_collide>0</self_collide>
