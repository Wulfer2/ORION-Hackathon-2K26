<?xml version="1.0"?>
<!-- thunderb_vtol: scaled from PX4 standard_vtol (4 m span, 40 kg MTOW incl. 5 kg payload).
     First-pass estimates, not BlueBird data. Make sure the build does not regenerate this
     file from standard_vtol's .jinja template, or these edits will be overwritten. -->
<sdf version='1.10'>
  <model name='thunderb_vtol'>
    <pose>0 0 0.42 0 0 0</pose>
    <link name='base_link'>
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>35</mass>
        <inertia>
          <ixx>22</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>10</iyy><iyz>0</iyz>
          <izz>31</izz>
        </inertia>
      </inertial>
      <collision name='base_link_collision'>
        <pose>0 0 -0.13 0 0 0</pose>
        <geometry><box><size>1.03 4.0 0.09</size></box></geometry>
        <surface>
          <contact><ode><kp>100000</kp><kd>1.0</kd><max_vel>0.1</max_vel><min_depth>0.001</min_depth></ode></contact>
          <friction><ode /></friction>
        </surface>
      </collision>
      <!-- Landing legs: rigid struts under the booms. Feet bottom at z = -0.40 (below the pusher prop, -0.25). -->
      <collision name='leg_fr_foot_collision'>
        <pose>0.5 -0.8 -0.37 0 0 0</pose>
        <geometry><sphere><radius>0.03</radius></sphere></geometry>
        <surface>
          <contact><ode><kp>100000</kp><kd>1.0</kd><max_vel>0.1</max_vel><min_depth>0.001</min_depth></ode></contact>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name='leg_fr_strut'>
        <pose>0.5 -0.8 -0.185 0 0 0</pose>
        <geometry><cylinder><length>0.37</length><radius>0.015</radius></cylinder></geometry>
        <material><ambient>.1 .1 .1 1.0</ambient><diffuse>.1 .1 .1 1.0</diffuse></material>
      </visual>
      <visual name='leg_fr_foot_visual'>
        <pose>0.5 -0.8 -0.37 0 0 0</pose>
        <geometry><sphere><radius>0.03</radius></sphere></geometry>
        <material><ambient>.1 .1 .1 1.0</ambient><diffuse>.1 .1 .1 1.0</diffuse></material>
      </visual>
      <collision name='leg_fl_foot_collision'>
        <pose>0.5 0.8 -0.37 0 0 0</pose>
        <geometry><sphere><radius>0.03</radius></sphere></geometry>
        <surface>
          <contact><ode><kp>100000</kp><kd>1.0</kd><max_vel>0.1</max_vel><min_depth>0.001</min_depth></ode></contact>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name='leg_fl_strut'>
        <pose>0.5 0.8 -0.185 0 0 0</pose>
        <geometry><cylinder><length>0.37</length><radius>0.015</radius></cylinder></geometry>
        <material><ambient>.1 .1 .1 1.0</ambient><diffuse>.1 .1 .1 1.0</diffuse></material>
      </visual>
      <visual name='leg_fl_foot_visual'>
        <pose>0.5 0.8 -0.37 0 0 0</pose>
        <geometry><sphere><radius>0.03</radius></sphere></geometry>
        <material><ambient>.1 .1 .1 1.0</ambient><diffuse>.1 .1 .1 1.0</diffuse></material>
      </visual>
      <collision name='leg_rr_foot_collision'>
        <pose>-0.5 -0.8 -0.37 0 0 0</pose>
        <geometry><sphere><radius>0.03</radius></sphere></geometry>
        <surface>
          <contact><ode><kp>100000</kp><kd>1.0</kd><max_vel>0.1</max_vel><min_depth>0.001</min_depth></ode></contact>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name='leg_rr_strut'>
        <pose>-0.5 -0.8 -0.185 0 0 0</pose>
        <geometry><cylinder><length>0.37</length><radius>0.015</radius></cylinder></geometry>
        <material><ambient>.1 .1 .1 1.0</ambient><diffuse>.1 .1 .1 1.0</diffuse></material>
      </visual>
      <visual name='leg_rr_foot_visual'>
        <pose>-0.5 -0.8 -0.37 0 0 0</pose>
        <geometry><sphere><radius>0.03</radius></sphere></geometry>
        <material><ambient>.1 .1 .1 1.0</ambient><diffuse>.1 .1 .1 1.0</diffuse></material>
      </visual>
      <collision name='leg_rl_foot_collision'>
        <pose>-0.5 0.8 -0.37 0 0 0</pose>
        <geometry><sphere><radius>0.03</radius></sphere></geometry>
        <surface>
          <contact><ode><kp>100000</kp><kd>1.0</kd><max_vel>0.1</max_vel><min_depth>0.001</min_depth></ode></contact>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name='leg_rl_strut'>
        <pose>-0.5 0.8 -0.185 0 0 0</pose>
        <geometry><cylinder><length>0.37</length><radius>0.015</radius></cylinder></geometry>
        <material><ambient>.1 .1 .1 1.0</ambient><diffuse>.1 .1 .1 1.0</diffuse></material>
      </visual>
      <visual name='leg_rl_foot_visual'>
        <pose>-0.5 0.8 -0.37 0 0 0</pose>
        <geometry><sphere><radius>0.03</radius></sphere></geometry>
        <material><ambient>.1 .1 .1 1.0</ambient><diffuse>.1 .1 .1 1.0</diffuse></material>
      </visual>
      <visual name='base_link_visual'>
        <pose>0.989 -2.000 -0.187 1.5707963268 0 3.1415926536</pose>
        <geometry>
          <mesh>
            <scale>0.001866 0.001866 0.001866</scale>
            <uri>model://standard_vtol/meshes/x8_wing.dae</uri>
          </mesh>
        </geometry>
        <material><ambient>.175 .175 .175 1.0</ambient><diffuse>.175 .175 .175 1.0</diffuse></material>
      </visual>
      <visual name='left_motor_column'>
        <pose>0 0.8 0.01 0 0 0</pose>
        <geometry><box><size>1.4 0.05 0.05</size></box></geometry>
        <material><ambient>.175 .175 .175 1.0</ambient><diffuse>.175 .175 .175 1.0</diffuse></material>
      </visual>
      <visual name='right_motor_column'>
        <pose>0 -0.8 0.01 0 0 0</pose>
        <geometry><box><size>1.4 0.05 0.05</size></box></geometry>
        <material><ambient>.175 .175 .175 1.0</ambient><diffuse>.175 .175 .175 1.0</diffuse></material>
      </visual>
      <visual name='m_rotor_0'>
        <pose>0.5 -0.8 0.04 0 0 0</pose>
        <geometry><cylinder><length>0.06</length><radius>0.05</radius></cylinder></geometry>
        <material><ambient>.175 .175 .175 1.0</ambient><diffuse>.175 .175 .175 1.0</diffuse></material>
      </visual>
      <visual name='m_rotor_1'>
        <pose>-0.5 0.8 0.04 0 0 0</pose>
        <geometry><cylinder><length>0.06</length><radius>0.05</radius></cylinder></geometry>
        <material><ambient>.175 .175 .175 1.0</ambient><diffuse>.175 .175 .175 1.0</diffuse></material>
      </visual>
      <visual name='m_rotor_2'>
        <pose>0.5 0.8 0.04 0 0 0</pose>
        <geometry><cylinder><length>0.06</length><radius>0.05</radius></cylinder></geometry>
        <material><ambient>.175 .175 .175 1.0</ambient><diffuse>.175 .175 .175 1.0</diffuse></material>
      </visual>
      <visual name='m_rotor_3'>
        <pose>-0.5 -0.8 0.04 0 0 0</pose>
        <geometry><cylinder><length>0.06</length><radius>0.05</radius></cylinder></geometry>
        <material><ambient>.175 .175 .175 1.0</ambient><diffuse>.175 .175 .175 1.0</diffuse></material>
      </visual>
      <gravity>1</gravity>
      <velocity_decay />
      <self_collide>0</self_collide>
      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0003394</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0003394</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0003394</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.004</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.004</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.004</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="air_pressure_sensor" type="air_pressure">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <pressure><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></pressure>
        </air_pressure>
      </sensor>
      <sensor name="magnetometer_sensor" type="magnetometer">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <x><noise type="gaussian"><stddev>0.0001</stddev></noise></x>
          <y><noise type="gaussian"><stddev>0.0001</stddev></noise></y>
          <z><noise type="gaussian"><stddev>0.0001</stddev></noise></z>
        </magnetometer>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>
    </link>

    <!-- 5 kg payload pod under the fuselage (0.35 x 0.20 x 0.14 m), centred 0.12 m below the base origin,
         x and y still on the CG. Visual only (no collision). Fixed joint for now; use a detachable joint for a drop. -->
    <link name="payload">
      <pose>0 0 -0.12 0 0 0</pose>
      <inertial>
        <mass>5.0</mass>
        <inertia><ixx>0.0248</ixx><iyy>0.0592</iyy><izz>0.0677</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name='payload_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.35 0.2 0.14</size></box></geometry>
        <material><ambient>0.95 0.5 0.1 1.0</ambient><diffuse>0.95 0.5 0.1 1.0</diffuse></material>
      </visual>
    </link>
    <joint name="payload_joint" type="fixed">
      <parent>base_link</parent><child>payload</child>
    </joint>

    <link name='rotor_0'>
      <pose>0.5 -0.8 0.07 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.005</mass>
        <inertia>
          <ixx>9.75e-07</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000166704</iyy><iyz>0</iyz>
          <izz>0.000167604</izz>
        </inertia>
      </inertial>
      <collision name='rotor_0_collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry><cylinder><length>0.005</length><radius>0.3</radius></cylinder></geometry>
        <surface><contact><ode /></contact><friction><ode /></friction></surface>
